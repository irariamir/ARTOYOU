# ─────────────────────────────────────────────────────────────
# ARTOYOU — sample configuration. Copy to `.env` and fill in.
# `.env` is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather (enables the bot).
# Create one with /newbot, then paste it here:
TELEGRAM_BOT_TOKEN=

# Restrict the bot with a STATIC allowlist (comma-separated user ids).
#   ← If set, ONLY these ids may use the bot (recommended for shared servers).
# If unset: the FIRST user to message the bot becomes its permanent owner
# (persisted in downloads/.bot_owner) and everyone else is rejected.
# Reset ownership:  rm downloads/.bot_owner   (then the next /start claim it)
TELEGRAM_ALLOWED_USERS=

# Optional proxy for YouTube traffic only, e.g. a local socks5 proxy (v2ray default):
# YT_PROXY=socks5h://127.0.0.1:10808

# Upload ceiling: on the cloud Bot API the limit is 50MB per file.
# To send bigger files, run a local Bot API server (https://github.com/tdlib/telegram-bot-api)
# and point the bot at it (uploads up to 2GB):
# TELEGRAM_API_BASE_URL=http://127.0.0.1:8081
# TELEGRAM_FILE_BASE_URL=http://127.0.0.1:8081

# Optional web-API shared secret (protects /api/* on the web app):
# ARTOYOU_TOKEN=

# Optional YouTube anti-bot helpers:
# YT_COOKIES_FILE=/path/to/cookies.txt
# YT_PLAYER_CLIENT=android,web
